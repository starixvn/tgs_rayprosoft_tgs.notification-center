    "https": {
      "commandName": "Project",
      "launchBrowser": true,
      "environmentVariables": {
        "ASPNETCORE_ENVIRONMENT": "Development",
        "OTEL_SERVICE_NAME": "NotificationCenter(local)",
        "NODE_IP": "otel.rpgp.cc",
        "LogServiceDomain": "otel.rpgp.cc"
      },
