<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net6.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <PackageId>Tgs.Notification.Client</PackageId>
    <Version>0.0.3</Version>
    <Authors>Raypro</Authors>
    <PackageProjectUrl>https://gitlab.com/rayprosoft/tgs.notification-center</PackageProjectUrl>
    <RepositoryUrl>https://gitlab.com/rayprosoft/tgs.notification-center.git</RepositoryUrl>
    <PackageTags>Tgs Notification</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Google.Protobuf" Version="3.24.3" />
    <PackageReference Include="PhoenixToolkits.MessageQueue" Version="1.0.3" />
    <PackageReference Include="PhoenixToolkits.NuGet.BuildTools" Version="0.0.3">
      <PrivateAssets>All</PrivateAssets>
    </PackageReference>
    <PackageReference Include="PhoenixToolkits.Protobuf.ExtendTypes" Version="0.0.6" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Notification.Common\Notification.Common.csproj">
      <PrivateAssets>All</PrivateAssets>
    </ProjectReference>
  </ItemGroup>

</Project>
